apiVersion: apps/v1
kind: Deployment
metadata:
  name: enrichment-web-deployment
spec:
  replicas: 1
  template:
    spec:
      containers:
        - name: enrichment-web
          imagePullPolicy: Always
          env:
            - name: JAVA_TOOL_OPTIONS
              value: "-Dlogging.config=/opt/app/config/log4j2-spring.xml"
          livenessProbe:
            httpGet:
              port: 8080
              path: /enrichment-k8s/actuator/health/liveness
              httpHeaders:
              - name: Accept
                value: application/json
            initialDelaySeconds: ${LIVE_CHECK_INIT_DELAY}
            periodSeconds: ${LIVE_CHECK_PERIOD}   
          readinessProbe:
            httpGet:
              port: 8080
              path: /enrichment-k8s/actuator/health/readiness
              httpHeaders:
              - name: Accept
                value: application/json
            initialDelaySeconds: ${READY_CHECK_INIT_DELAY}
            periodSeconds: ${READY_CHECK_PERIOD}  
          resources:
            requests:
              memory: "${MEMORY_REQUEST}M"
              cpu: "${CPU_REQUEST}m"
            limits:
              memory: "${MEMORY_LIMIT}M"
              cpu: "${CPU_LIMIT}m"           
